<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Genuix — Brand Identity</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
:root{
  --midnight:#0D1520;
  --gold:#C4952A;
  --gold-lt:#E8C06A;
  --gold-pale:#F5E6C0;
  --ivory:#F7F0E4;
  --ivory-dk:#EDE0C8;
  --teal:#1A7A6E;
  --graphite:#2E2E2E;
  --muted:#8A8070;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--ivory);color:var(--graphite);line-height:1.5}
@keyframes rise{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
.anim{opacity:0;animation:rise .9s ease forwards}

/* ── HERO ── */
.hero{
  background:var(--midnight);
  min-height:420px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:64px 40px 56px;
  text-align:center;
  position:relative;overflow:hidden;
  animation:rise 1s ease forwards;
}
.hero::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 70% 60% at 50% 40%,rgba(196,149,42,.07) 0%,transparent 70%);
  pointer-events:none;
}
.hero-grid{
  position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(196,149,42,.05) 1px,transparent 1px),
    linear-gradient(90deg,rgba(196,149,42,.05) 1px,transparent 1px);
  background-size:48px 48px;
  pointer-events:none;
}

/* Logo mark */
.logomark{width:96px;height:96px;margin-bottom:28px;filter:drop-shadow(0 0 18px rgba(196,149,42,.18))}
.wordmark{
  font-family:'Cormorant Garamond',serif;font-weight:300;font-size:54px;
  letter-spacing:14px;color:var(--ivory);text-transform:uppercase;line-height:1;
  margin-bottom:18px;
}
.tagline{
  font-family:'DM Sans',sans-serif;font-weight:300;font-size:13px;
  letter-spacing:4px;color:var(--gold);text-transform:uppercase;
  position:relative;display:inline-block;
}
.tagline::before,.tagline::after{
  content:'──';color:rgba(196,149,42,.4);
  margin:0 12px;font-size:10px;vertical-align:middle;
}
.hero-sub{font-size:12px;color:rgba(247,240,228,.3);letter-spacing:2px;
  text-transform:uppercase;font-family:'DM Mono',monospace;margin-top:8px;}

/* ── WRAPPER ── */
.wrap{max-width:920px;margin:0 auto;padding:0 40px}
.section{padding:52px 0;border-bottom:1px solid var(--ivory-dk)}
.section:last-child{border-bottom:none}
.sec-label{
  font-family:'DM Mono',monospace;font-size:10px;letter-spacing:3px;
  text-transform:uppercase;color:var(--muted);margin-bottom:28px;
  display:flex;align-items:center;gap:10px;
}
.sec-label::after{content:'';flex:1;height:1px;background:var(--ivory-dk)}

/* ── COLORS ── */
.color-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
.swatch{border-radius:10px;overflow:hidden;border:1px solid rgba(0,0,0,.07)}
.swatch-block{height:72px}
.swatch-info{background:#fff;padding:10px 12px}
.swatch-name{font-size:11px;font-weight:500;color:var(--graphite);margin-bottom:2px}
.swatch-hex{font-family:'DM Mono',monospace;font-size:10px;color:var(--muted)}
.swatch-role{font-size:9px;color:var(--muted);margin-top:2px;letter-spacing:.5px;text-transform:uppercase}

/* ── TYPOGRAPHY ── */
.type-row{display:flex;gap:32px;align-items:flex-start;padding:20px 0;border-top:1px solid var(--ivory-dk)}
.type-row:first-child{border-top:none;padding-top:0}
.type-meta{width:130px;flex-shrink:0;padding-top:4px}
.type-meta-tag{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.type-meta-name{font-size:12px;font-weight:500;color:var(--graphite);margin-bottom:3px}
.type-meta-use{font-size:11px;color:var(--muted);line-height:1.5}
.type-specimen{flex:1;border-left:2px solid var(--ivory-dk);padding-left:24px}
.type-accent{border-color:var(--gold)!important}

/* ── LOGO VARIANTS ── */
.variant-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.variant-card{border-radius:14px;padding:44px 36px;display:flex;flex-direction:column;align-items:center;gap:16px}
.variant-dark{background:var(--midnight)}
.variant-light{background:#fff;border:1px solid var(--ivory-dk)}
.variant-tag{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:2px;text-transform:uppercase;margin-top:4px}

/* ── POSITIONING ── */
.pullquote{
  font-family:'Cormorant Garamond',serif;font-weight:300;font-style:italic;
  font-size:23px;color:var(--graphite);line-height:1.55;
  border-left:3px solid var(--gold);padding-left:22px;margin-bottom:36px;
}
.pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.pillar{background:#fff;border:1px solid var(--ivory-dk);border-radius:12px;padding:22px 20px}
.pillar-num{font-family:'Cormorant Garamond',serif;font-size:44px;font-weight:300;color:var(--gold-pale);line-height:1;margin-bottom:8px}
.pillar-title{font-size:13px;font-weight:500;color:var(--graphite);margin-bottom:6px}
.pillar-body{font-size:12px;color:var(--muted);line-height:1.65}

/* ── BUSINESS CARD ── */
.card-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.bcard{border-radius:14px;overflow:hidden;box-shadow:0 6px 28px rgba(0,0,0,.13);aspect-ratio:1.75}
.bcard-front{
  background:var(--midnight);width:100%;height:100%;
  padding:22px 24px;display:flex;flex-direction:column;justify-content:space-between;
  position:relative;overflow:hidden;
}
.bcard-front::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 85% 15%,rgba(196,149,42,.08) 0%,transparent 60%);
}
.bcard-back{
  background:var(--ivory);width:100%;height:100%;
  padding:22px;display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;
  border:1px solid var(--ivory-dk);
}
.bc-name{font-family:'Cormorant Garamond',serif;font-size:17px;font-weight:400;color:var(--ivory);letter-spacing:.5px}
.bc-title{font-size:9px;color:var(--gold);letter-spacing:2.5px;text-transform:uppercase;margin-top:3px}
.bc-contact{font-family:'DM Mono',monospace;font-size:8.5px;color:rgba(247,240,228,.38);line-height:1.9;margin-top:2px}
.bc-back-word{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:300;letter-spacing:8px;text-transform:uppercase;color:var(--midnight);margin-top:10px}
.bc-back-tag{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-top:6px;font-family:'DM Sans',sans-serif;font-weight:300}

/* ── APP ICONS ── */
.icon-row{display:flex;align-items:center;gap:20px}
.app-icon{border-radius:22%;overflow:hidden;box-shadow:0 4px 18px rgba(0,0,0,.14);flex-shrink:0}

/* ── DATA DISPLAY ── */
.data-demo{
  background:var(--midnight);border-radius:14px;padding:28px 30px;
  font-family:'DM Mono',monospace;
}
.data-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(247,240,228,.06)}
.data-row:last-child{border-bottom:none}
.data-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(247,240,228,.3)}
.data-value{font-size:15px;color:var(--gold);letter-spacing:1px}
.data-value.verified{color:#1A7A6E}
.data-header{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:rgba(247,240,228,.2);margin-bottom:16px}

@media(max-width:640px){
  .color-grid{grid-template-columns:repeat(3,1fr)}
  .pillar-grid{grid-template-columns:1fr}
  .card-row{grid-template-columns:1fr}
  .variant-grid{grid-template-columns:1fr}
  .wordmark{font-size:38px;letter-spacing:8px}
  .wrap{padding:0 20px}
}
</style>
</head>
