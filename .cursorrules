# ── 5. ENVIRONMENT VARIABLES ────────────────────────────────

## frontend/.env.local
  NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
  NEXT_PUBLIC_SUPABASE_KEY=your-anon-key
  NEXT_PUBLIC_API_URL=http://localhost:8000

## backend/.env
  ANTHROPIC_API_KEY=sk-ant-api03-...
  SUPABASE_URL=https://xxx.supabase.co
  SUPABASE_KEY=your-service-role-key
  MCX_API_KEY=your-mcx-key

## Security rules
  - NEVER import ANTHROPIC_API_KEY in any frontend file
  - NEVER use SUPABASE service role key on frontend (anon key only)
  - All AI calls go through backend — frontend never calls Anthropic directly
  - Always add .env and .env.local to .gitignore


# ── 6. FRONTEND CODING RULES ────────────────────────────────

## General
  - Always TypeScript — no .js files, no 'any' type
  - Use 'use client' only when component needs interactivity
  - Prefer server components for data fetching pages
  - No inline styles — Tailwind classes only
  - No CSS modules — Tailwind only
  - Import order: React → Next → third-party → local

## Component structure (always follow this pattern)
  ```tsx
  // components/verify/VerificationResult.tsx
  'use client'

  import { Badge } from '@/components/ui/badge'
  import { cn } from '@/lib/utils'
  import type { GoldVerification } from '@/types'

  interface VerificationResultProps {
    result: GoldVerification
    className?: string
  }

  export function VerificationResult({ result, className }: VerificationResultProps) {
    return (
      <div className={cn('bg-midnight border border-white/10 rounded-lg p-6', className)}>
        {/* content */}
      </div>
    )
  }
  ```

## Naming conventions
  - Components   : PascalCase (VerificationResult.tsx)
  - Hooks        : camelCase with 'use' prefix (useGoldRate.ts)
  - Utilities    : camelCase (formatGoldRate, calcJewelryValue)
  - Types        : PascalCase interfaces (GoldVerification, InventoryItem)
  - API routes   : kebab-case URL (/gold-rate, /verify)
  - CSS classes  : Tailwind utilities only

## Tailwind patterns for Genuix UI
  Dark card     : "bg-midnight border border-white/10 rounded-lg"
  Gold button   : "bg-gold hover:bg-gold-light text-midnight font-medium"
  Teal badge    : "bg-teal/15 text-teal border border-teal/30"
  Section label : "text-[10px] font-mono tracking-[3px] uppercase text-muted"
  Display text  : "font-cormorant font-light text-ivory"
  Data value    : "font-mono text-gold tracking-wider"
  Muted text    : "text-sm text-muted"

## Data formatting (always use these helpers from lib/utils.ts)
  formatRupees(value: number)     → "₹7,23,450" (Indian lakh format)
  formatWeight(grams: number)     → "8.42 g"
  formatPurity(purity: string)    → "22K · 916"
  formatGoldRate(rate: number)    → "₹7,230 / gram"

## API calls (always go through lib/api.ts)
  ```ts
  // lib/api.ts
  const API = process.env.NEXT_PUBLIC_API_URL

  export const verifyGold = async (file: File) => {
    const form = new FormData()
    form.append('image', file)
    const res = await fetch(`${API}/verify`, { method: 'POST', body: form })
    if (!res.ok) throw new Error('Verification failed')
    return res.json() as Promise<GoldVerification>
  }

  export const getGoldRate = async () => {
    const res = await fetch(`${API}/gold-rate`)
    return res.json() as Promise<GoldRate>
  }
  ```


# ── 7. BACKEND CODING RULES ─────────────────────────────────

## General
  - Python 3.11 — use type hints everywhere
  - Pydantic v2 for all request/response models
  - All Claude API calls MUST go through services/claude_service.py
  - Never call anthropic.Anthropic() directly in a router
  - Always use async/await for I/O operations
  - Use HTTPException with proper status codes

## FastAPI router pattern
  ```python
  # app/routers/verify.py
  from fastapi import APIRouter, UploadFile, File, HTTPException
  from app.services import claude_service, image_service
  from app.models.verification import VerificationResult

  router = APIRouter(prefix="/verify", tags=["verification"])

  @router.post("/", response_model=VerificationResult)
  async def verify_gold(image: UploadFile = File(...)):
      if not image.content_type.startswith("image/"):
          raise HTTPException(status_code=400, detail="File must be an image")
      img_bytes = await image.read()
      processed = image_service.enhance(img_bytes)
      result = await claude_service.analyze_jewelry(processed)
      return result
  ```

## Claude service pattern (the most important file)
  ```python
  # app/services/claude_service.py
  import anthropic
  import base64
  from app.config import ANTHROPIC_API_KEY
  from app.models.verification import VerificationResult

  client = anthropic.Anthropic(api_key=ANTHROPIC_API_KEY)

  JEWELRY_ANALYSIS_PROMPT = """
  You are an expert gold jewelry analyst with 20+ years of experience
  in the Indian jewelry market. Analyze this jewelry image and provide:

  1. Gold purity estimate (24K/22K/18K/14K)
  2. Purity in parts per thousand (999/916/750/585)
  3. BIS hallmark detection (visible or not visible)
  4. If hallmark visible: extract the BIS ID code if readable
  5. Confidence percentage (0-100) in your purity assessment
  6. Brief reason for your assessment

  Respond ONLY as JSON (no markdown, no explanation outside JSON):
  {
    "purity": "22K",
    "purity_num": 916,
    "bis_visible": true,
    "bis_id": "BIS-2024-MH-04471",
    "confidence": 94.5,
    "reasoning": "Clear hexagonal BIS stamp visible, yellow color consistent with 22K"
  }
  """

  async def analyze_jewelry(image_bytes: bytes) -> VerificationResult:
      b64 = base64.b64encode(image_bytes).decode()
      message = client.messages.create(
          model="claude-opus-4-8",
          max_tokens=1000,
          messages=[{
              "role": "user",
              "content": [
                  {
                      "type": "image",
                      "source": {
                          "type": "base64",
                          "media_type": "image/jpeg",
                          "data": b64
                      }
                  },
                  {"type": "text", "text": JEWELRY_ANALYSIS_PROMPT}
              ]
          }]
      )
      import json
      data = json.loads(message.content[0].text)
      return VerificationResult(**data)
  ```

## Pydantic model pattern
  ```python
  # app/models/verification.py
  from pydantic import BaseModel, Field

  class VerificationResult(BaseModel):
      purity: str              # "22K"
      purity_num: int          # 916
      bis_visible: bool
      bis_id: str | None = None
      confidence: float        # 0.0 - 100.0
      reasoning: str
      estimated_value: float | None = None  # populated after rate lookup
  ```


# ── 8. BUSINESS LOGIC — GOLD CALCULATIONS ───────────────────

## Gold purity grades (Indian standard)
  24K = 999 (pure gold, rarely used in jewelry)
  22K = 916 (most common in India — daily wear)
  18K = 750 (used in diamond-set jewelry)
  14K = 585 (rare in India)

## Value calculation formula
  gold_value   = weight_grams × (purity_num / 1000) × rate_per_gram
  making_total = gold_value × (making_charge_pct / 100)
  subtotal     = gold_value + making_total + wastage_amount
  gst          = subtotal × 0.03   ← GST on gold is always 3% in India
  total        = subtotal + gst

## MCX rate notes
  - MCX publishes rates in ₹ per 10 grams
  - Always convert: rate_per_gram = mcx_rate / 10
  - Rates change throughout the day (market hours: 9am–11:30pm IST)
  - Cache rates for 5 minutes to avoid API hammering
  - Store rate at time of transaction for audit trail

## Indian number formatting
  - Use lakh/crore system: ₹1,00,000 not ₹100,000
  - Format function: new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' })

## BIS Hallmark format (India)
  Standard: BIS-YYYY-ST-NNNNN
  Example : BIS-2024-MH-04471
  ST = state code (MH=Maharashtra, TN=Tamil Nadu, GJ=Gujarat)
  Required on all gold jewelry sold in India since 2021


# ── 9. SUPABASE SCHEMA ──────────────────────────────────────

## Core tables
  shops        : id, name, owner_name, city, state, gst_number, plan, created_at
  profiles     : id (= auth.users.id), shop_id, role, full_name, phone
  verifications: id, shop_id, image_url, purity, purity_num, bis_verified,
                 bis_id, confidence, weight, estimated_value, gold_rate_at_time,
                 created_at
  inventory    : id, shop_id, name, weight, purity, purity_num, image_url,
                 purchase_rate, current_value, added_at
  customers    : id, shop_id, name, phone, email, city, total_purchases, created_at
  bills        : id, shop_id, customer_id, items (jsonb), subtotal, gst, total,
                 gold_rate_used, created_at, pdf_url

## Row Level Security (always enable)
  All tables: users can only read/write rows where shop_id matches their profile's shop_id


# ── 10. WHAT CURSOR SHOULD NEVER DO ─────────────────────────

  ✗ Do NOT use pages/ router — always App Router
  ✗ Do NOT use CSS modules or styled-components
  ✗ Do NOT use 'any' TypeScript type
  ✗ Do NOT call Anthropic API from frontend files
  ✗ Do NOT hardcode API keys anywhere in code
  ✗ Do NOT use pure white (#ffffff) backgrounds — use ivory (#F7F0E4)
  ✗ Do NOT use generic green for verified states — use teal (#1A7A6E)
  ✗ Do NOT use rounded-full for main action buttons
  ✗ Do NOT use axios — use native fetch wrapped in lib/api.ts
  ✗ Do NOT create new Anthropic client in routers — use claude_service.py
  ✗ Do NOT skip loading/error states in UI components
  ✗ Do NOT format currency without Indian lakh system
  ✗ Do NOT forget CORS headers in FastAPI for localhost:3000
  ✗ Do NOT use margins/padding in Tailwind without Genuix spacing scale
  ✗ Do NOT generate placeholder/lorem ipsum content — use jewelry domain data


# ── 11. DEV COMMANDS ────────────────────────────────────────

## Start frontend (PowerShell)
  cd frontend && npm run dev
  → runs on http://localhost:3000

## Start backend (PowerShell)
  cd backend && uvicorn app.main:app --reload --port 8000
  → runs on http://localhost:8000
  → API docs at http://localhost:8000/docs

## Install shadcn component
  cd frontend && npx shadcn-ui@latest add [component-name]

## Add Python package
  pip install package-name && pip freeze > requirements.txt


